# Optional explicit env file path used by backend loaders/scripts (usually leave blank).
ENV_FILE=

# Test runtime mode.
NODE_ENV=test
# Test server port.
PORT=4001
# Test JWT signing secret.
JWT_SECRET=test_only_secret
# Test JWT lifetime.
JWT_EXPIRES_IN=7d
# Optional test CORS origins (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Preferred test database connection string.
DATABASE_URL=
# Split Postgres host fallback when DATABASE_URL is not set.
DB_HOST=localhost
# Split Postgres port fallback when DATABASE_URL is not set.
DB_PORT=5432
# Split Postgres user fallback when DATABASE_URL is not set.
DB_USER=postgres
# Split Postgres password fallback when DATABASE_URL is not set.
DB_PASSWORD=postgres
# Split Postgres database fallback when DATABASE_URL is not set.
DB_NAME=d6_student_communicator_test

# Optional upload directory override for tests.
UPLOAD_DIR=

# Test auth policy flags.
AUTH_REQUIRE_OTP=false
# Allow password-only login in tests.
AUTH_ALLOW_PASSWORD_LOGIN=true
# Allow password-only register in tests.
AUTH_ALLOW_PASSWORD_REGISTER=true
# Staff registration password for admin/lecturer test cases.
AUTH_STAFF_REGISTER_PASSWORD=staff_secret

# Return OTP code directly in test/dev responses.
OTP_RETURN_DEV_CODE=true
# OTP lifetime in minutes for tests.
OTP_TTL_MINUTES=10
# Max OTP verify attempts for tests.
OTP_MAX_ATTEMPTS=5
# Email OTP rate-limit window in minutes for tests.
OTP_EMAIL_WINDOW_MINUTES=10
# Max OTP requests per email per window for tests.
OTP_EMAIL_MAX_PER_WINDOW=50
# IP OTP rate-limit window in minutes for tests.
OTP_IP_WINDOW_MINUTES=10
# Max OTP requests per IP per window for tests.
OTP_IP_MAX_PER_WINDOW=200

# Thread policy mode used by thread-related tests.
THREADS_MODE=D6

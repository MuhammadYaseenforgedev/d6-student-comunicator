# Optional explicit env file path used by backend loaders/scripts. Usually leave blank.
ENV_FILE=

# Runtime mode for Node/Express.
NODE_ENV=development

# App environment used by auth/demo safeguards.
APP_ENV=development

# Local backend HTTP port.
PORT=5000

# Local Postgres connection string. Production should override this in Render.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/d6_dev

# Split Postgres fallback values used only when DATABASE_URL is blank.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=d6_dev

# JWT signing secret for local development only. Use a strong secret in production.
JWT_SECRET=dev_jwt_secret_123

# JWT lifetime passed to jsonwebtoken.
JWT_EXPIRES_IN=1d

# Local auth switches. Production code still forces stricter production behavior.
AUTH_REQUIRE_OTP=false
AUTH_ALLOW_PASSWORD_LOGIN=true
AUTH_ALLOW_PASSWORD_REGISTER=true

# Shared password required for ADMIN/LECTURER self-registration in local dev.
AUTH_STAFF_REGISTER_PASSWORD=staff_secret

# Frontend origins allowed by backend CORS.
CORS_ORIGIN=http://localhost:5173

# Comma-separated CORS origin list. Leave blank to use CORS_ORIGIN plus dev defaults.
CORS_ALLOW_ORIGINS=

# Supabase Storage config. Leave blank locally to use filesystem uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Local/dev fallback upload directory. Blank resolves to backend/uploads.
UPLOAD_DIR=

# Thread policy mode: D6 is the app's strict role matrix.
THREADS_MODE=D6

# Optional Microsoft Teams deep links shown in Messages by role.
TEAMS_LINK_ADMIN=
TEAMS_LINK_LECTURER=
TEAMS_LINK_STUDENT=

# Optional OpenAI assistant config. Keep the API key on the backend only.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.4-mini

# Optional Pulse ticket sync. Keep disabled for local development.
PULSE_SYNC_ENABLED=false
PULSE_TICKET_FORM_URL=https://pulse.forgetalent.co.za/ticket.php
PULSE_SYNC_TIMEOUT_MS=10000

# Demo OTP bypass controls. Disabled by default.
ALLOW_DEMO_OTP_BYPASS=false
DEMO_OTP_ALLOWLIST=
DEMO_OTP_ALLOWED_ENVS=test,staging,demo
DEMO_BYPASS_LOGIN=false

# Demo seed routes. Disabled by default.
DEMO_SEED_ENABLED=false

# OTP timing and rate-limit controls.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_WINDOW_MINUTES=10
OTP_EMAIL_MAX_PER_WINDOW=5
OTP_IP_WINDOW_MINUTES=10
OTP_IP_MAX_PER_WINDOW=25

# Learner activation link lifetime in hours.
LEARNER_ACTIVATION_TTL_HOURS=72

# Optional SMTP config. Leave blank locally unless testing email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional bootstrap credentials used by scripts/demo-bootstrap.ps1.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

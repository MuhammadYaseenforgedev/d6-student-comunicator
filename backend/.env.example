# Optional explicit env file path used by backend loaders/scripts (usually leave blank).
ENV_FILE=

# App runtime mode.
NODE_ENV=development
# HTTP port for backend server.
PORT=4000

# JWT signing secret (required in all environments).
JWT_SECRET=change_me_for_local_demo
# JWT lifetime passed to jsonwebtoken (e.g. 7d, 12h).
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Preferred cloud database connection string (Render/Neon style).
DATABASE_URL=
# Split Postgres host fallback when DATABASE_URL is not set.
DB_HOST=localhost
# Split Postgres port fallback when DATABASE_URL is not set.
DB_PORT=5432
# Split Postgres user fallback when DATABASE_URL is not set.
DB_USER=postgres
# Split Postgres password fallback when DATABASE_URL is not set.
DB_PASSWORD=postgres
# Split Postgres database name fallback when DATABASE_URL is not set.
DB_NAME=d6_student_communicator

# Optional upload directory override (defaults to backend/uploads).
UPLOAD_DIR=

# Require OTP on login/register requests.
AUTH_REQUIRE_OTP=false
# Allow password-only login when OTP is not provided.
AUTH_ALLOW_PASSWORD_LOGIN=true
# Allow password-only register when OTP is not provided.
AUTH_ALLOW_PASSWORD_REGISTER=false
# Shared password required for ADMIN/LECTURER self-registration.
AUTH_STAFF_REGISTER_PASSWORD=staff_secret

# Return OTP code in API response for local/dev only.
OTP_RETURN_DEV_CODE=true
# OTP lifetime in minutes.
OTP_TTL_MINUTES=10
# Max OTP verify attempts before lockout.
OTP_MAX_ATTEMPTS=5
# Email OTP rate-limit window (minutes).
OTP_EMAIL_WINDOW_MINUTES=10
# Max OTP requests per email per window.
OTP_EMAIL_MAX_PER_WINDOW=5
# IP OTP rate-limit window (minutes).
OTP_IP_WINDOW_MINUTES=10
# Max OTP requests per IP per window.
OTP_IP_MAX_PER_WINDOW=25

# Thread policy mode: D6 (strict role matrix) or ANY (legacy/open).
THREADS_MODE=D6

# Optional bootstrap credentials used by scripts/demo-bootstrap.ps1.
BOOTSTRAP_ADMIN_EMAIL=
# Optional bootstrap password used by scripts/demo-bootstrap.ps1.
BOOTSTRAP_ADMIN_PASSWORD=
# Optional demo admin email override used by bootstrap scripts.
ADMIN_EMAIL=
# Optional demo admin password override used by bootstrap scripts.
ADMIN_PASSWORD=
# Optional seed admin email override used by bootstrap scripts.
SEED_ADMIN_EMAIL=
# Optional seed admin password override used by bootstrap scripts.
SEED_ADMIN_PASSWORD=

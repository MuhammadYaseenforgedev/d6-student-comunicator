{
  "name": "backend",
  "version": "1.0.0",
  "description": "Forge Communicator Backend (Express + TypeScript + Postgres)",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node scripts/migrate.cjs",

    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",

    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",

    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:rbac": "jest rbac --runInBand",
    "test:walkthrough": "jest --runInBand src/test/auth.register.roles.test.ts src/test/rbac.matrix.test.ts src/test/announcements.uploads.permissions.test.ts src/test/parent.link.sa-id.test.ts src/test/thread.permissions.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.2.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}

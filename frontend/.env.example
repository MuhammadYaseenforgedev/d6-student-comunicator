# Backend origin used by frontend API calls. Do not add /api here.
VITE_API_URL=http://localhost:5000

# API target selector used by src/lib/apiClient.ts ("primary" or "secondary").
VITE_API_TARGET=primary

# Frontend data mode: "api" uses backend calls.
VITE_DATA_MODE=api

# Dev-server proxy target used by vite.config.ts during npm run dev.
VITE_BACKEND_PROXY_TARGET=http://localhost:5000

# Optional second backend origin for multi-API prep. Leave blank locally.
VITE_API_URL_SECONDARY=

# Backend origin used by frontend API calls (required for production builds).
# Production example: VITE_API_URL=https://<your-render-backend>.onrender.com
# Do not leave this as localhost in Vercel production.
VITE_API_URL=http://localhost:4000

# Optional second backend origin for multi-API prep. Leave blank unless intentionally used.
VITE_API_URL_SECONDARY=

# API target selector used by src/lib/apiClient.ts ("primary" | "secondary").
# Production should normally use primary.
VITE_API_TARGET=primary

# Optional legacy direct API origin override for local/dev compatibility only.
VITE_API_BASE_URL=

# Frontend data mode: "api" uses backend calls, "mock"/"demo" keeps local demo data.
# Production must use api.
VITE_DATA_MODE=api

# Local demo login is disabled by default and only works with VITE_DATA_MODE=mock/demo.
# Production must keep this false.
VITE_ENABLE_DEMO_LOGIN=false

# Dev-server proxy target used by vite.config.ts during `npm run dev`.
VITE_BACKEND_PROXY_TARGET=http://localhost:4000
